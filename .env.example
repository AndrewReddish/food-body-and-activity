# Copy to .env.local for `npm run dev`. Both values are in Supabase → Project Settings → API.
# The publishable (anon) key is safe in the browser: row-level security limits every row to its owner.
# Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
